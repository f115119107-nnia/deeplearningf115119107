# Shopify integration injects store credentials into the server runtime.
# If using app-owned credentials instead, configure them as server-only secrets.
# PUBLIC_STORE_DOMAIN=your-store.myshopify.com
# PUBLIC_STOREFRONT_API_TOKEN=your-public-storefront-token
# Never expose PRIVATE_STOREFRONT_API_TOKEN to browser code.
# Public storefront ID for Shopify analytics; use "0" if not provisioned.
PUBLIC_STOREFRONT_ID=0
# PUBLIC_CHECKOUT_DOMAIN=checkout.your-store-domain.example
